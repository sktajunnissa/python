from tkinter import *

a = Tk()
a.geometry("400x500")
a.title("CALCULATOR")
a.configure(bg="black")   # Window background color

# Entry Box
x = Entry(
    a,
    width=20,
    font=("Arial", 25, "bold"),
    bg="white",
    fg="black",
    bd=10,
    relief=SUNKEN,
    justify=RIGHT
)

x.grid(column=0, row=0, columnspan=4, pady=20)

# Functions
def click(num):
    curr = x.get()
    x.delete(0, END)
    x.insert(0, str(curr) + str(num))

def clear():
    x.delete(0, END)

def equal():
    res = eval(x.get())
    x.delete(0, END)
    x.insert(0, res)

# Button Design
btn_font = ("Arial", 14, "bold")

# Row 1
Button(a, text="1", width=6, height=3,
       bg="light blue", fg="white",
       font=btn_font,
       activebackground="gray",
       command=lambda: click(1)).grid(row=1, column=0, padx=5, pady=5)

